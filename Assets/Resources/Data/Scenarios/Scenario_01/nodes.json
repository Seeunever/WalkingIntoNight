{
  "scenarioId": "Scenario_01",
  "title": "咖啡馆关店后的失踪",
  "startNodeId": "intro_01",
  "nodes": [
    {
      "id": "intro_01",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "邮件没有署名，只有一句话：如果你看见它，说明我已经错过了打烊。请在午夜前来夜航咖啡馆，别让里面只剩一盏灯。",
      "nextNodeId": "intro_motive"
    },
    {
      "id": "intro_motive",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "雨落在车窗上，咖啡馆的招牌隔着水痕发白。你仍然可以掉头。你为什么继续往前？",
      "choices": [
        { "text": "这是委托。我来把事情做完。", "nextNodeId": "set_motive_duty" },
        { "text": "这扇门让我想起一个等过人的地方。", "nextNodeId": "set_motive_memory" },
        { "text": "有人求救，我不想假装没看见。", "nextNodeId": "set_motive_kindness" }
      ]
    },
    {
      "id": "set_motive_duty",
      "type": "setflag",
      "flag": "motive_duty",
      "flagValue": true,
      "speaker": "旁白",
      "text": "你把邮件归进委托记录，推门下车。",
      "nextNodeId": "intro_02"
    },
    {
      "id": "set_motive_memory",
      "type": "setflag",
      "flag": "motive_memory",
      "flagValue": true,
      "speaker": "旁白",
      "text": "你没有继续追究那个念头。至少今晚没有。",
      "nextNodeId": "intro_02"
    },
    {
      "id": "set_motive_kindness",
      "type": "setflag",
      "flag": "motive_kindness",
      "flagValue": true,
      "speaker": "旁白",
      "text": "这理由不够专业，但足够让你在雨里撑开伞。",
      "nextNodeId": "intro_02"
    },
    {
      "id": "intro_02",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "门牌已经翻到「休息」，里面却亮着最后一盏暖黄的灯。吧台摆着三只杯子：两杯咖啡已经冷透，第三只没有倒咖啡，杯柄朝门，瓷壁还留着刚被热水烫过的薄雾。",
      "locationId": "cafe_main",
      "nextNodeId": "intro_cat_mirror"
    },
    {
      "id": "intro_cat_mirror",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "风铃只响了一声。店猫从你脚边绕开，宁可贴着桌腿，也不肯经过墙上的大镜子。你抬头时，它的倒影迟了半拍才转过脸。",
      "nextNodeId": "set_cat_mirror_intro"
    },
    {
      "id": "set_cat_mirror_intro",
      "type": "setflag",
      "flag": "cat_mirror",
      "flagValue": true,
      "flagNotice": "店猫的倒影比它慢了半拍。",
      "nextNodeId": "intro_03"
    },
    {
      "id": "intro_03",
      "type": "dialogue",
      "speaker": "店员小梅",
      "text": "“我们已经打烊了。”柜台后的小梅看了一眼没有落锁的门，又改口，“应该说，我们本来打算永远打烊。”",
      "choices": [
        { "text": "出示匿名邮件", "nextNodeId": "intro_email_shown" },
        { "text": "先问第三只杯子给谁", "nextNodeId": "intro_third_cup" },
        { "text": "观察大厅环境", "nextNodeId": "check_spot_main" },
        { "text": "先自己看看", "nextNodeId": "intro_hall_threads" }
      ]
    },
    {
      "id": "intro_email_shown",
      "type": "dialogue",
      "speaker": "店员小梅",
      "text": "小梅读到「午夜」两个字，手指停在纸边：“老板昨晚没有回家。他从不把最后一盏灯留给别人，也不会拿关店这种事开玩笑。”",
      "nextNodeId": "intro_hall_threads"
    },
    {
      "id": "intro_third_cup",
      "type": "dialogue",
      "speaker": "店员小梅",
      "text": "“不是给客人的。”小梅把第三只杯子往里推了半寸，目光却落到角落的老陈身上，“老板说，等人到齐再倒。可昨晚少了一个人。”",
      "nextNodeId": "intro_hall_threads"
    },
    {
      "id": "intro_hall_threads",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "小梅守着最后一盏灯；老陈面前放着两只杯碟；店猫则始终避开那面镜子。三条沉默都在等人先开口。",
      "choices": [
        { "text": "直接询问店员小梅", "nextNodeId": "npc_mei_talk" },
        { "text": "问问角落里的老陈", "nextNodeId": "npc_chen_talk" },
        { "text": "跟着避开镜子的店猫", "nextNodeId": "npc_cat_talk" },
        { "text": "先自己看看", "nextNodeId": "hub_explore" }
      ]
    },
    {
      "id": "check_spot_main",
      "type": "check",
      "speaker": "侦查",
      "text": "你环顾大厅，寻找不自然的细节……",
      "skillId": "spot_hidden",
      "difficulty": 0,
      "successNodeId": "spot_success",
      "failureNodeId": "spot_fail"
    },
    {
      "id": "spot_success",
      "type": "giveitem",
      "itemId": "silver_coin",
      "text": "你在吧台缝隙发现一枚冰冷的银币，年代不明。",
      "nextNodeId": "set_found_coin"
    },
    {
      "id": "spot_fail",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "雨水和灯影把每一处反光都搅在一起。你暂时分不清异常来自哪里，但大厅里的三位证人仍在。",
      "nextNodeId": "intro_hall_threads"
    },
    {
      "id": "set_found_coin",
      "type": "setflag",
      "flag": "found_coin",
      "flagValue": true,
      "flagNotice": "银币会对午夜的镜面异象产生回应。",
      "nextNodeId": "intro_hall_threads"
    },
    {
      "id": "hub_explore",
      "type": "location",
      "speaker": "旁白",
      "text": "你可以自由调查咖啡馆。使用左侧「地点/NPC」与角色互动，或继续推进主线。",
      "locationId": "",
      "allowExploration": true,
      "choices": [
        { "text": "检查储藏室的门", "nextNodeId": "goto_storage", "requiredFlag": "", "blockedByFlag": "" },
        { "text": "深入地下室（需钥匙）", "nextNodeId": "goto_basement_check", "requiredItemId": "rusty_key", "unavailableReason": "需要先在储藏室找到生锈的钥匙。" },
        { "text": "阅读老板日记（若已取得）", "nextNodeId": "read_diary", "requiredItemId": "owner_diary", "unavailableReason": "需要先从吧台暗格取得老板的日记。" },
        { "text": "推进：午夜钟声", "nextNodeId": "midnight_event", "requiredFlag": "found_coin", "unavailableReason": "需要先找到会对镜面异象产生回应的银币。" }
      ]
    },
    {
      "id": "goto_storage",
      "type": "location",
      "speaker": "旁白",
      "text": "储藏室弥漫着受潮纸板的气味。店猫蹲在面粉袋上，注视着你。",
      "locationId": "cafe_storage",
      "nextNodeId": "storage_check"
    },
    {
      "id": "storage_check",
      "type": "check",
      "speaker": "聆听",
      "text": "你屏息聆听墙壁另一侧的动静……",
      "skillId": "listen",
      "difficulty": 1,
      "successNodeId": "storage_key",
      "failureNodeId": "hub_explore"
    },
    {
      "id": "storage_key",
      "type": "giveitem",
      "itemId": "rusty_key",
      "text": "门后传来轻微刮擦声。你在门框上发现一把生锈的钥匙。",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "goto_basement_check",
      "type": "changesan",
      "sanDelta": -2,
      "speaker": "旁白",
      "text": "地下室阶梯向下延伸。寒意爬上脊背。（理智 -2）",
      "nextNodeId": "basement_enter"
    },
    {
      "id": "basement_enter",
      "type": "location",
      "speaker": "旁白",
      "text": "地下室墙壁布满湿滑符号。黑衣女人静立阴影中。",
      "locationId": "cafe_basement",
      "nextNodeId": "basement_choice"
    },
    {
      "id": "basement_choice",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "空气愈发粘稠。你感到有什么在注视你。",
      "choices": [
        { "text": "调查墙上符号", "nextNodeId": "check_occult_wall" },
        { "text": "与黑衣女人交谈", "nextNodeId": "npc_woman_talk" },
        { "text": "强行前进", "nextNodeId": "combat_shadow_rat" }
      ]
    },
    {
      "id": "check_occult_wall",
      "type": "check",
      "speaker": "神秘学",
      "text": "你试图辨认符号的含义……",
      "skillId": "occult",
      "difficulty": 1,
      "successNodeId": "give_symbol",
      "failureNodeId": "san_loss_fail"
    },
    {
      "id": "give_symbol",
      "type": "giveitem",
      "itemId": "strange_symbol",
      "text": "符号的含义刺痛你的大脑，但你拓下了一张草图。",
      "nextNodeId": "set_know_ritual"
    },
    {
      "id": "set_know_ritual",
      "type": "setflag",
      "flag": "know_ritual",
      "flagValue": true,
      "flagNotice": "你已读懂墙上符号：符号拓片可以打断镜中仪式。",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "san_loss_fail",
      "type": "changesan",
      "sanDelta": -5,
      "speaker": "旁白",
      "text": "符号蠕动了一下。你无法移开视线。（理智 -5）",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "npc_mei_talk",
      "type": "dialogue",
      "speaker": "店员小梅",
      "text": "“老板不是会失约的人。他哪怕发烧，也会等我走过街口再关最后一盏灯。昨晚灯没有灭，我却先走了。”",
      "choices": [
        { "text": "心理学：请她把昨晚慢慢说一遍", "nextNodeId": "check_psych_mei" },
        { "text": "暂时离开", "nextNodeId": "hub_explore" }
      ]
    },
    {
      "id": "check_psych_mei",
      "type": "check",
      "speaker": "心理学",
      "text": "你没有追问地下室，只问昨晚是谁替她关了灯。",
      "skillId": "psychology",
      "difficulty": 0,
      "successNodeId": "mei_reveal",
      "failureNodeId": "hub_explore"
    },
    {
      "id": "mei_reveal",
      "type": "setflag",
      "flag": "mei_trust",
      "flagValue": true,
      "speaker": "店员小梅",
      "text": "她颤抖着说：「老板提到『深海咖啡馆』……午夜会听见歌声。老陈也听见过，他一直替我守着大厅。」",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "npc_chen_talk",
      "type": "dialogue",
      "speaker": "常客老陈",
      "text": "老陈把一张发黄的报纸折回原样：“报纸上的事，隔得久了，看起来都像发生在别人身上。可这不是第一次有人从这里消失。”",
      "nextNodeId": "chen_library"
    },
    {
      "id": "chen_library",
      "type": "check",
      "speaker": "图书馆使用",
      "text": "你追问五十年前的新闻线索……",
      "skillId": "library_use",
      "difficulty": 0,
      "successNodeId": "give_diary_hint",
      "failureNodeId": "hub_explore"
    },
    {
      "id": "give_diary_hint",
      "type": "dialogue",
      "speaker": "常客老陈",
      "text": "「老板把日记藏在吧台第三块松动的木板下。」",
      "nextNodeId": "bar_diary_search"
    },
    {
      "id": "bar_diary_search",
      "type": "check",
      "speaker": "侦查",
      "text": "你检查吧台下方……",
      "skillId": "spot_hidden",
      "difficulty": 0,
      "successNodeId": "give_diary",
      "failureNodeId": "hub_explore"
    },
    {
      "id": "give_diary",
      "type": "giveitem",
      "itemId": "owner_diary",
      "text": "你找到了老板的日记。最后一页写着：「午夜，歌声响起时，不要看镜子。」",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "npc_cat_talk",
      "type": "dialogue",
      "speaker": "店猫",
      "text": "店猫没有回应你的招呼。它在大镜子两步外停下，盯着镜中的自己。倒影先它一步弓起背，猫随即转身，朝储藏室门口走去。",
      "nextNodeId": "set_cat_guided"
    },
    {
      "id": "set_cat_guided",
      "type": "setflag",
      "flag": "cat_guided",
      "flagValue": true,
      "flagNotice": "店猫反复避开镜面，并朝储藏室引路。",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "npc_woman_talk",
      "type": "dialogue",
      "speaker": "黑衣女人",
      "text": "「调查员……你本不该来这里。他在镜子里。」",
      "choices": [
        { "text": "说服她让路", "nextNodeId": "check_persuade_woman" },
        { "text": "撤退", "nextNodeId": "hub_explore" }
      ]
    },
    {
      "id": "check_persuade_woman",
      "type": "check",
      "speaker": "说服",
      "text": "你尝试与她交涉……",
      "skillId": "persuade",
      "difficulty": 1,
      "successNodeId": "woman_pass",
      "failureNodeId": "combat_cultist"
    },
    {
      "id": "woman_pass",
      "type": "setflag",
      "flag": "woman_pass",
      "flagValue": true,
      "speaker": "黑衣女人",
      "text": "她侧身消失于阴影，留下一串潮湿脚印通向深处。",
      "nextNodeId": "midnight_event"
    },
    {
      "id": "npc_owner_talk",
      "type": "dialogue",
      "speaker": "老板的影子",
      "text": "扭曲的人形喃喃：「咖啡……海水……一样的咸……」",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "read_diary",
      "type": "changesan",
      "sanDelta": -3,
      "speaker": "旁白",
      "text": "日记记载着连续的噩梦与镜子里的脸。（理智 -3）",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "midnight_event",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "午夜钟声敲响十二下。店内所有镜面泛起波纹，深海般的歌声从地下室涌出。",
      "nextNodeId": "midnight_san_check"
    },
    {
      "id": "midnight_san_check",
      "type": "check",
      "speaker": "理智",
      "text": "面对不可名状的歌声，你努力保持清醒……（POW×5 简化为本节点 SAN 检定替代：使用 psychology 代表）",
      "skillId": "psychology",
      "difficulty": 1,
      "successNodeId": "final_choice",
      "failureNodeId": "midnight_failure_choice"
    },
    {
      "id": "midnight_failure_choice",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "歌声钻进颅骨，你几乎忘了自己为何而来。最后一丝清醒仍在提醒你：选择权还没有被夺走。",
      "choices": [
        { "text": "咬破舌尖，忍痛保持清醒（SAN -5）", "nextNodeId": "midnight_failure_cost" },
        { "text": "回应镜中的歌声", "nextNodeId": "end_madness" }
      ]
    },
    {
      "id": "midnight_failure_cost",
      "type": "changesan",
      "sanDelta": -5,
      "speaker": "旁白",
      "text": "疼痛让现实重新有了边缘。你摇晃着站稳，面对镜中的老板。（理智 -5）",
      "nextNodeId": "final_choice"
    },
    {
      "id": "final_choice",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "镜中浮现老板的脸。你要如何结束这一切？",
      "choices": [
        { "text": "用符号拓片打断仪式（需知晓仪式）", "nextNodeId": "end_good", "requiredFlag": "know_ritual", "unavailableReason": "需要先读懂地下室墙上的仪式符号。" },
        { "text": "举银币对准镜面（需发现银币）", "nextNodeId": "end_neutral", "requiredFlag": "found_coin", "unavailableReason": "需要先在大厅找到那枚银币。" },
        { "text": "拔枪射击镜面（鲁莽）", "nextNodeId": "combat_cultist" }
      ]
    },
    {
      "id": "combat_shadow_rat",
      "type": "combat",
      "speaker": "旁白",
      "text": "影鼠从排水口涌出！",
      "combatId": "shadow_rat",
      "winNodeId": "after_rat_win",
      "loseNodeId": "end_bad",
      "fleeNodeId": "hub_explore"
    },
    {
      "id": "after_rat_win",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "你击退了影鼠，地上留下黑色黏液。",
      "nextNodeId": "hub_explore"
    },
    {
      "id": "combat_cultist",
      "type": "combat",
      "speaker": "旁白",
      "text": "狂热侍从从镜中爬出！",
      "combatId": "cultist_acolyte",
      "winNodeId": "after_cult_win",
      "loseNodeId": "end_bad",
      "fleeNodeId": "hub_explore"
    },
    {
      "id": "after_cult_win",
      "type": "dialogue",
      "speaker": "旁白",
      "text": "侍从倒下后化作盐水。钟声减弱了一瞬。",
      "nextNodeId": "final_choice"
    },
    {
      "id": "end_good",
      "type": "end",
      "speaker": "结局",
      "text": "你将拓片按在镜面上，歌声戛然而止。老板跌出镜子，虚弱但活着。咖啡馆的灯一盏盏熄灭——案件告一段落。",
      "endTitle": "生还者"
    },
    {
      "id": "end_neutral",
      "type": "end",
      "speaker": "结局",
      "text": "银币吸收镜面波纹，老板失踪案再无痕迹。你独自离开雨夜，心中仍有余悸。",
      "endTitle": "无声收束"
    },
    {
      "id": "end_madness",
      "type": "end",
      "speaker": "结局",
      "text": "歌声钻进颅骨。你微笑着走入镜中，成为咖啡馆又一位「常客」。",
      "endTitle": "永恒顾客"
    },
    {
      "id": "end_bad",
      "type": "end",
      "speaker": "结局",
      "text": "黑暗吞没视野。调查员失踪案又多了一条无名记录。",
      "endTitle": "失踪"
    }
  ]
}
